# Configure real values in Vercel Environment Variables, never in source control.
# Never put private secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=

# Neon/Postgres (server-side)
DATABASE_URL=

# Authentication (server-side)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Transactional email — required for activation and password recovery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cakto — webhook endpoint: /api/webhooks/cakto
CAKTO_API_TOKEN=
CAKTO_WEBHOOK_SECRET=
CAKTO_PRODUCT_ID=

# SyncPay — use the webhook secret/token generated in the SyncPay panel.
# Webhook endpoint planned: /api/webhooks/syncpay
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_API_TOKEN=
SYNCPAY_WEBHOOK_SECRET=
SYNCPAY_PRODUCT_ID=
