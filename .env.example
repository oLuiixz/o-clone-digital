# Configure real values in Vercel Environment Variables, not in source control.
# Never put private secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=

# Neon/Postgres (server-side)
DATABASE_URL=

# Authentication — not active until implemented and tested
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Transactional email — not active until implemented and tested
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cakto — fill only after confirming the official API/webhook requirements
CAKTO_API_TOKEN=
CAKTO_WEBHOOK_SECRET=
CAKTO_PRODUCT_ID=

# SyncPay — fill only after confirming the official API/webhook requirements
SYNCPAY_API_TOKEN=
SYNCPAY_WEBHOOK_SECRET=
SYNCPAY_PRODUCT_ID=
